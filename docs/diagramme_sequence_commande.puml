@startuml
' =====================================================
' DIAGRAMME DE SÉQUENCE - EXÉCUTION D’UNE COMMANDE
' Projet : X-Vision
' Auteur : Antoine Mailhot & Micaël Racine-Leblanc 
' Description : Représente l’exécution d’une commande
'               (exemple : Zoom sur une Perspective)
' =====================================================

title X-Vision - Diagramme de séquence : Exécution d’une commande (Zoom ou Translation)

actor Utilisateur as U
participant "VuePerspective" as V
participant "SourisControleur" as C
participant "GestionnaireCommandes (Singleton)" as G
participant "CommandeZoom" as Z
participant "Perspective (Modèle)" as P

' =====================================================
' SCÉNARIO : L’utilisateur effectue un zoom via la souris
' =====================================================

U -> V : Interaction (roue souris / geste zoom)
V -> C : notifierActionUtilisateur("zoom")
C -> G : executerCommande(new CommandeZoom(P, facteur))
G -> Z : executer()
activate Z

' --- Application du zoom sur la perspective ---
Z -> P : appliquerZoom(facteur)
activate P
P -> P : ajusterFacteurEchelle(facteur)
P --> Z : mise à jour terminée
deactivate P

' --- Notification des observateurs (vues abonnées) ---
Z -> P : notifier()
P -> V : mettreAJour()
V -> V : rafraichirAffichage()
V --> P : affichage mis à jour

' --- Ajout à l’historique pour Undo/Redo ---
Z -> G : enregistrerCommande(this)
G -> G : push(commande)
deactivate Z

' --- Fin de la commande ---
G --> C : confirmation d’exécution
C --> V : signal de fin

' =====================================================
' LÉGENDE :
'  - Utilisateur : initie la commande (événement souris ou menu)
'  - VuePerspective : transmet l’action au contrôleur
'  - SourisControleur : crée et envoie la commande au GestionnaireCommandes
'  - GestionnaireCommandes : centralise l’historique et exécute la commande
'  - CommandeZoom : encapsule l’action
'  - Perspective : modèle modifié qui notifie ses observateurs
' =====================================================

@enduml
