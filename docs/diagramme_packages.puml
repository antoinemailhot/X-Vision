@startuml Diagramme de Packages X-Vision
!define LIGHTBLUE #E3F2FD
!define LIGHTGREEN #E8F5E9
!define LIGHTYELLOW #FFF9C4
!define LIGHTPINK #FCE4EC
!define LIGHTORANGE #FFE0B2

title Structure des Packages et Modules X-Vision\nArchitecture MVC + Patrons GoF/GRASP

skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam ArrowThickness 2

' ============ Package Principal ============
package "xvision" LIGHTPINK {
    [MainGUI\n419 lignes\nPoint d'entrée] as Main
}

' ============ Package Modèle ============
package "xvision.model" LIGHTBLUE {
    note as ModelNote
        **MODÈLE (19 classes, ~2200 lignes)**
        Logique métier pure
        Ne connaît JAMAIS les vues
        Notifie via Observer
    end note

    package "Gestion Perspectives\n(Composite)" {
        [PerspectiveComponent\nInterface] as PComp
        [PerspectiveLeaf\n262 lignes\nFeuille Composite] as PLeaf
        [PerspectiveComposite\n23 lignes\nNœud Composite] as PComposite
        [GestionnaireDePerspectives\n150 lignes\nCreator] as GPers
    }

    package "Observer" {
        [Sujet\n70 lignes\nClasse abstraite] as Sujet
    }

    package "Memento" {
        [PerspectiveMemento\n147 lignes\nSnapshot immuable] as PMemento
        [GestionnaireMemento\n109 lignes\nCaretaker] as GMemento
    }

    package "Adapter + Factory" {
        [ImageTarget\n51 lignes\nInterface Target] as ITarget
        [AdapterPNG\n104 lignes] as APNG
        [AdapterJPEG] as AJPEG
        [AdapterSVG] as ASVG
        [FabriqueImage\n198 lignes\nFactory Method] as Fabrique
        [ImagePNG\nAdaptee] as IPNG
        [ImageJPEG\nAdaptee] as IJPEG
        [ImageSVG\nAdaptee] as ISVG
    }

    package "Annotations & Crop" {
        [Annotation\nAbstraite] as Annot
        [AnnotationLigne] as ALine
        [GestionnaireAnnotations] as GAnnot
        [Crop] as Crop
        [GestionnaireCrop] as GCrop
    }

    package "Utilitaires" {
        [Identifiant\nGénérateur IDs] as ID
    }
}

' ============ Package Vue ============
package "xvision.view" LIGHTGREEN {
    note as ViewNote
        **VUE (7 classes, ~800 lignes)**
        Affichage uniquement
        Implémentent ObserverIF
        Aucune logique métier
    end note

    package "Observer Interface" {
        [ObserverIF\n5 lignes\nInterface] as ObsIF
    }

    package "Vues Abstraites" {
        [VueAbstraite\n101 lignes\nTemplate Method] as VAbst
    }

    package "Vues Concrètes" {
        [Vignette\nMiniature] as Vignette
        [VueMini\nMini vue] as VMini
        [VuePrincipale\n253 lignes\n⚠️ N'hérite pas VueAbstraite] as VPrin
        [VueAnnotations\nPreview annotations] as VAnnot
        [MinimapOverlay\nMinimap Google Maps] as MMap
    }
}

' ============ Package Contrôleur ============
package "xvision.controller" LIGHTYELLOW {
    note as ControllerNote
        **CONTRÔLEUR (19 classes, ~1800 lignes)**
        Gère événements utilisateur
        Toutes modifications via Commandes
        Aucune modification directe du modèle
    end note

    package "Command" {
        [Commande\n6 lignes\nInterface] as Cmd
        [CommandeZoom\n47 lignes] as CZoom
        [CommandeTranslation] as CTrans
        [CommandeAjouterAnnotation] as CAnnot
        [CommandeDefinirCrop] as CCrop
        [GestionnaireCommandes\n38 lignes\nSingleton] as GCmd
    }

    package "Mediator" {
        [Mediator\nInterface] as Med
        [MediatorCopie\n20 lignes] as MCopie
        [GestionnaireCopie\n19 lignes\n⚠️ Strategy manquant] as GCopie
    }

    package "State (Modes)" {
        [ModeInteraction\n34 lignes\nInterface State] as Mode
        [ModeNavigation\nPan/Zoom] as MNav
        [ModeLigne\nDessin ligne] as MLigne
        [ModeCrop\nSélection crop] as MCrop
        [ContexteMode\n73 lignes\nContexte State] as Contexte
        [GestionnaireOutils\nGestionnaire modes] as GOutils
    }

    package "Outils" {
        [OutilDessin\nInterface] as ODessin
        [OutilLigne] as OLigne
        [OutilCrop] as OCrop
    }

    package "Contrôleur Principal" {
        [ControleurPerspective\nCentralise opérations] as CPers
        [ConvertisseurCoordonnees\nEcran ↔ Image] as Conv
    }
}

' ============ Package Tests ============
package "xvision.test" LIGHTORANGE {
    note as TestNote
        **TESTS (6 classes, ~500 lignes)**
        Tests patrons GoF
        Tests principes GRASP
        Tests Observer + MVC
    end note

    [TestAdaptateurs] as TAdapt
    [TestComposite] as TComp
    [TestGoF] as TGoF
    [TestGRASP] as TGRASP
    [TestObserverMVC] as TMVC
    [TestRunner] as TRun
}

' ============ Relations MVC ============
Main --> GPers : crée
Main --> CPers : utilise
Main --> PLeaf : observe
Main --> GOutils : gère modes

' Modèle ↔ Vue (Observer)
Sujet --> ObsIF : notifie
VAbst --> Sujet : observe
VPrin --> Sujet : observe
Vignette --> Sujet : observe
VMini --> Sujet : observe
VAnnot --> Sujet : observe
MMap --> Sujet : observe

' Contrôleur → Modèle (Command)
CZoom --> PLeaf : modifie
CTrans --> PLeaf : modifie
CCrop --> PLeaf : modifie
CAnnot --> GAnnot : modifie
CPers --> GPers : utilise
CPers ..> Cmd : crée
GCmd --> Cmd : gère

' Vue → Contrôleur
VPrin --> CPers : utilise
MMap --> CPers : utilise

' Relations internes Modèle
PLeaf --|> Sujet
PLeaf ..|> PComp
PComposite ..|> PComp
GPers o-- PComp
PLeaf --> GMemento : utilise
PLeaf ..> PMemento : crée
GMemento o-- PMemento
Fabrique ..> ITarget : crée
APNG ..|> ITarget
AJPEG ..|> ITarget
ASVG ..|> ITarget
APNG o-- IPNG
AJPEG o-- IJPEG
ASVG o-- ISVG
ALine --|> Annot
GAnnot o-- Annot
PLeaf --> Crop : a un

' Relations internes Vue
ObsIF <|.. VAbst
VAbst <|-- Vignette
VAbst <|-- VMini
ObsIF <|.. VPrin
ObsIF <|.. VAnnot
ObsIF <|.. MMap

' Relations internes Contrôleur
Cmd <|.. CZoom
Cmd <|.. CTrans
Cmd <|.. CAnnot
Cmd <|.. CCrop
GCmd o-- Cmd
Med <|.. MCopie
GCopie --> MCopie
Mode <|.. MNav
Mode <|.. MLigne
Mode <|.. MCrop
GOutils --> Mode
GOutils --> Contexte
MLigne --> OLigne
MCrop --> OCrop
ODessin <|.. OLigne
ODessin <|.. OCrop

' Relations Tests
TAdapt ..> APNG : teste
TComp ..> PComp : teste
TMVC ..> Sujet : teste
TMVC ..> ObsIF : teste
TGoF ..> Fabrique : teste
TGoF ..> GCmd : teste

' ============ Statistiques ============
note bottom
    **MÉTRIQUES GLOBALES**
    Lignes totales: ~5440
    Packages: 6
    Classes: 54
    Interfaces: 8
    Classes abstraites: 3

    **DISTRIBUTION**
    model/: 19 classes (~2200 lignes)
    view/: 7 classes (~800 lignes)
    controller/: 19 classes (~1800 lignes)
    test/: 6 classes (~500 lignes)
    MainGUI: 1 classe (419 lignes)

    **CONFORMITÉ**
    MVC: 96.7%
    Patrons GoF: 91% (8/9 complets)
    GRASP: 99%
end note

' ============ Dépendances entre packages ============
note as DepNote
    **DÉPENDANCES MVC**
    ✅ model/ → view/: AUCUNE (découplage total)
    ✅ view/ → model/: Unidirectionnelle (observe Sujet)
    ✅ controller/ → model/: Via Commandes
    ✅ controller/ → view/: AUCUNE

    **RÈGLE D'OR MVC**
    Le modèle ne connaît JAMAIS les vues!
end note

@enduml
