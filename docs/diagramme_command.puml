@startuml
' =====================================================
' DIAGRAMME DE CLASSES - PATRON COMMAND
' Projet : X-Vision
' Auteur : Antoine Mailhot & Micaël Racine-Leblanc 
' Description : Implémentation du patron Command pour les
'               opérations de Zoom et de Translation.
' =====================================================

title X-Vision - Diagramme de classes : Patron Command (Zoom / Translation)

interface Commande {
    +executer() : void
    +annuler() : void
}

class CommandeZoom implements Commande {
    -perspective : PerspectiveLeaf
    -ancienZoom : double
    -nouveauZoom : double
    +CommandeZoom(perspective : PerspectiveLeaf, nouveauZoom : double)
    +executer() : void
    +annuler() : void
}

class CommandeTranslation implements Commande {
    -perspective : PerspectiveLeaf
    -ancienneX : double
    -ancienneY : double
    -nouvelleX : double
    -nouvelleY : double
    +CommandeTranslation(perspective : PerspectiveLeaf, dx : double, dy : double)
    +executer() : void
    +annuler() : void
}

class CommandeAjouterAnnotation implements Commande {
    -gestionnaireAnnotations : GestionnaireAnnotations
    -annotation : Annotation
    +CommandeAjouterAnnotation(gestionnaire : GestionnaireAnnotations, annot : Annotation)
    +executer() : void
    +annuler() : void
}

class CommandeDefinirCrop implements Commande {
    -perspective : PerspectiveLeaf
    -ancienCrop : Crop
    -nouveauCrop : Crop
    +CommandeDefinirCrop(perspective : PerspectiveLeaf, crop : Crop)
    +executer() : void
    +annuler() : void
}

class GestionnaireCommandes <<Singleton>> {
    -{static} instance : GestionnaireCommandes
    -pileUndo : Stack<Commande>
    -pileRedo : Stack<Commande>
    -GestionnaireCommandes()
    +{static} getInstance() : GestionnaireCommandes
    +executerCommande(cmd : Commande) : void
    +undo() : void
    +redo() : void
}

class PerspectiveLeaf {
    -zoom : double
    -x : double
    -y : double
    -crop : Crop
    +setZoom(zoom : double) : void
    +setCentre(x : double, y : double) : void
    +setCrop(crop : Crop) : void
}

class GestionnaireAnnotations {
    -annotations : List<Annotation>
    +ajouter(a : Annotation) : void
    +supprimer(a : Annotation) : void
}

' =====================================================
' RELATIONS ENTRE LES CLASSES
' =====================================================
Commande <|.. CommandeZoom
Commande <|.. CommandeTranslation
Commande <|.. CommandeAjouterAnnotation
Commande <|.. CommandeDefinirCrop
GestionnaireCommandes o-- Commande : gère >
CommandeZoom --> PerspectiveLeaf : modifie >
CommandeTranslation --> PerspectiveLeaf : modifie >
CommandeAjouterAnnotation --> GestionnaireAnnotations : modifie >
CommandeDefinirCrop --> PerspectiveLeaf : modifie >

note right of GestionnaireCommandes
    **Patron Singleton (GoF)**
    - Constructeur privé
    - getInstance() statique
    - Instance unique partagée

    **Patron Command (GoF)**
    - Invoker qui gère Undo/Redo
    - Maintient 2 piles (Undo/Redo)

    **GRASP: Controller**
end note

@enduml
